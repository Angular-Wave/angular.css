{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "allowJs": false,
    "emitDeclarationOnly": true,
    "outDir": "@types",
    "rootDir": "src",
    "target": "ES2023"
  },
  "include": ["src/index.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
