{
  "name": "@angular-wave/angular.css",
  "description": "HTML-first styles and focused components for AngularTS",
  "license": "MIT",
  "version": "0.0.2",
  "type": "module",
  "main": "dist/angular-css.esm.js",
  "module": "dist/angular-css.esm.js",
  "browser": "dist/angular-css.umd.js",
  "types": "@types/index.d.ts",
  "style": "dist/angular.css",
  "exports": {
    ".": {
      "types": "./@types/index.d.ts",
      "import": "./dist/angular-css.esm.js",
      "default": "./dist/angular-css.esm.js"
    },
    "./angular.css": "./dist/angular.css",
    "./dist/angular.css": "./dist/angular.css",
    "./package.json": "./package.json",
    "./customization-tokens": "./tokens/angularcss.resolver.json",
    "./tokens/*": "./tokens/*"
  },
  "files": [
    "@types",
    "dist",
    "tokens",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SUPPORT.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angular-wave/angular.css.git"
  },
  "homepage": "https://angular-wave.github.io/angular.css/",
  "bugs": {
    "url": "https://github.com/angular-wave/angular.css/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "AngularJS",
    "AngularTS",
    "AngularCSS"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "serve": "npm-run-all --parallel dev express css-dev",
    "dev": "vite",
    "express": "node --watch ./utils/express.js",
    "build": "npm run build:js && npm run build:types && npm run css-prod",
    "build:js": "npm run build:js-artifacts && npm run sync:catalog-examples && npm run sync:application-examples",
    "build:js-artifacts": "rollup -c && mkdir -p docs/static/js && cp dist/angular-css.umd.js docs/static/js/angular-css.umd.js && cp node_modules/@angular-wave/angular.ts/dist/angular-ts.umd.js docs/static/js/angular-ts.umd.js",
    "build:test-artifacts": "npm run build:js-artifacts && npm run css-prod",
    "build:types": "node scripts/build-types.mjs",
    "check": "npm run format:check && npm run tokens:check && npm run lint && npm run typecheck && npm run lint:css && npm run check:angular-ts-version && npm run check:typescript-source && npm run check:underscore-property-keys && npm run check:html-syntax && npm run check:css-isolation && npm run check:css-cascade && npm run check:angular-overlap && npm run check:authored-selector-simplicity && npm run check:component-entrypoints && npm run check:component-registry && npm run check:developer-index && npm run check:catalog-examples && npm run check:application-examples && npm run check:docs-inventory && npm run check:docs-content && npm run check:public-api && npm run check:docs-site && npm run check:types-output && npm run check:test-inventory && npm run check:test-navigation && npm run check:built-artifact-tests && npm run check:test-ports && npm run check:performance-budgets && npm run check:release",
    "check:angular-ts-version": "node scripts/check-angular-ts-version.mjs",
    "check:typescript-source": "node scripts/check-typescript-source.mjs",
    "check:underscore-property-keys": "node scripts/check-underscore-property-keys.mjs",
    "check:html-syntax": "node scripts/check-html-syntax.ts",
    "check:css-isolation": "node scripts/check-css-isolation.mjs",
    "check:css-cascade": "node scripts/check-css-cascade.ts",
    "check:angular-overlap": "node scripts/check-angular-overlap.mjs",
    "check:authored-selector-simplicity": "node scripts/check-authored-selector-simplicity.ts",
    "check:component-entrypoints": "node scripts/check-component-entrypoints.mjs",
    "check:component-registry": "node scripts/check-component-registry.mjs",
    "check:developer-index": "node scripts/check-developer-index.ts",
    "check:catalog-examples": "node scripts/sync-catalog-examples.ts --check",
    "check:application-examples": "node scripts/sync-application-examples.ts --check",
    "check:docs-inventory": "node scripts/check-docs-inventory.mjs",
    "check:docs-content": "node scripts/generate-component-docs.ts --check",
    "check:public-api": "node scripts/check-public-api.mjs",
    "check:docs-site": "node scripts/check-docs-site.ts",
    "check:types-output": "node scripts/check-types-output.mjs",
    "check:test-inventory": "node scripts/check-test-inventory.mjs",
    "check:test-navigation": "node scripts/check-test-navigation.ts",
    "check:built-artifact-tests": "node scripts/check-built-artifact-tests.ts",
    "check:test-ports": "node scripts/check-test-ports.mjs",
    "check:performance-budgets": "node scripts/check-performance-budgets.mjs",
    "check:release": "node --test scripts/release-utils.test.mjs && node scripts/release.mjs validate",
    "check:package-consumer": "node scripts/check-package-consumer.mjs",
    "format": "prettier ./src ./tokens terrazzo.config.js performance-budgets.json README.md --write --cache --log-level=silent",
    "format:check": "prettier ./src ./tokens terrazzo.config.js performance-budgets.json README.md --check --cache --log-level=silent",
    "lint": "eslint ./src --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "lint:css": "stylelint \"src/**/*.css\" \"docs/static/examples/example.css\" \"docs/static/css/site.css\" \"examples/**/*.css\"",
    "lint:css:fix": "npm run lint:css -- --fix",
    "typecheck": "tsc && tsc --project tsconfig.test.json",
    "test": "playwright test",
    "test:docs": "npm run test:docs:examples && npm run test:docs:site",
    "test:docs:examples": "playwright test src/docs-examples.test.ts",
    "test:docs:site": "playwright test --config playwright.hugo.config.ts",
    "test:components": "playwright test src/foundations src/elements src/patterns src/components src/recipes",
    "css-dev": "node scripts/build-css.mjs --watch",
    "css-prod": "node scripts/build-css.mjs",
    "playwright": "./node_modules/.bin/playwright test",
    "generate-docs": "node scripts/generate-component-docs.ts",
    "generate-docs:components": "node scripts/generate-component-docs.ts",
    "fix:authored-selector-simplicity": "node scripts/check-authored-selector-simplicity.ts --write",
    "migrate:test-artifact-baseline": "node scripts/check-built-artifact-tests.ts --write",
    "sync:application-examples": "node scripts/sync-application-examples.ts",
    "sync:catalog-examples": "node scripts/sync-catalog-examples.ts",
    "release:build": "rm -rf dist @types && npm run build",
    "prepack": "npm run release:build",
    "prepare": "husky",
    "tokens:build": "terrazzo build --config terrazzo.config.js",
    "tokens:check": "node scripts/check-customization-tokens.mjs",
    "update:public-api": "node scripts/check-public-api.mjs --write"
  },
  "dependencies": {
    "@angular-wave/angular.ts": "latest",
    "chrono-node": "^2.10.1",
    "date-fns": "^4.4.0",
    "embla-carousel": "8.5.2",
    "embla-carousel-autoplay": "8.5.2",
    "lucide": "^1.33.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "latest",
    "@rollup/plugin-commonjs": "latest",
    "@rollup/plugin-node-resolve": "latest",
    "@rollup/plugin-terser": "latest",
    "@rollup/plugin-typescript": "latest",
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@types/jasmine": "latest",
    "@types/node": "^26.4.0",
    "browserslist": "^4.28.9",
    "chokidar": "^5.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "latest",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-promise": "latest",
    "express": "latest",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "npm-run-all": "latest",
    "playwright": "latest",
    "prettier": "latest",
    "rollup": "latest",
    "rollup-plugin-version-injector": "latest",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tslib": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
